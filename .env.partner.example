# Janob HR Partner Bot
# BotFather'dan olingan yangi alohida partner bot tokeni.
PARTNER_BOT_TOKEN=

# Referral link mijozni QAYSI ASOSIY Janob HR botga olib boradi.
# Bu yerga hamkor bot username'ini yozmang.
# To'g'ri qiymat: asosiy nomzod/biznes bot username'i, @ belgisiz.
# Hozirgi live asosiy bot: janobHR_bot
JANOBHR_MAIN_BOT_USERNAME=janobHR_bot

# Orqaga moslik uchun qoldirilgan eski nom. Yangi loyihada JANOBHR_MAIN_BOT_USERNAME ishlating.
PARTNER_REFERRAL_TARGET_USERNAME=janobHR_bot

# Mavjud Janob HR bazasidan foydalanadi.
SQLITE_PATH=/data/data.db

# Partner arizalarini tasdiqlaydigan founder Telegram ID'lari.
# Asosiy config.py aynan shu env qiymatni o'qiydi.
FOUNDER_USER_ID=
