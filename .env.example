# --- Majburiy ---
# @BotFather'dan olingan token (Telegram > @BotFather > /newbot)
BOT_TOKEN=

# Anketalar tushadigan admin guruh/kanal ID'si.
# Guruh yaratib, botni admin qiling, so'ng @userinfobot orqali guruh ID'sini oling (masalan -1001234567890)
ADMIN_GROUP_ID=

# --- Ixtiyoriy: umumiy sozlamalar ---
# Bitta savolga javob uchun belgilar chegarasi (standart: 800).
MAX_ANSWER_CHARS=800

# --- Ixtiyoriy: AI baholash (Scoring) tizimi ---
# OpenAI (yoki OpenAI-compatible) API kaliti. Bo'sh qoldirilsa, AI baholash o'chirilgan holda ishlaydi.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Ixtiyoriy: zaxira AI provayderlar ---
# Asosiy provayder (yuqoridagi) ishlamay qolsa (kredit tugasa, limit yoki server
# xatosi), bot avtomatik navbatdagilarga o'tadi. Kalit bo'sh qoldirilsa, o'sha
# provayder shunchaki o'tkazib yuboriladi.
#
# Zaxira 1 (standart: Groq — tez va bepul tarifi saxiy)
AI_API_KEY_2=
AI_API_BASE_2=https://api.groq.com/openai/v1
AI_MODEL_2=openai/gpt-oss-120b
# Zaxira 2 (standart: DeepSeek — juda arzon)
AI_API_KEY_3=
AI_API_BASE_3=https://api.deepseek.com/v1
AI_MODEL_3=deepseek-v4-flash

# --- Ixtiyoriy: "Sell" bosqichi (yuqori ball olgan nomzodlarga avtomatik taklif) ---
# O'rtacha AI ball shu chegaradan yuqori bo'lsa (0-100), nomzodga taklif yuboriladi.
SELL_SCORE_THRESHOLD=80
# Nomzodga yuboriladigan taklif matni (HTML formatlash bilan).
COMPANY_PITCH_TEXT=
# Ixtiyoriy: taklif bilan birga yuboriladigan rasm URL manzili.
COMPANY_PITCH_IMAGE_URL=
# Nomzod tanlaydigan suhbat vaqtlari, vergul bilan ajratilgan.
INTERVIEW_SLOTS=Ertaga soat 14:00,Ertaga soat 16:00,Bu hafta ichida qulay payt
# Har bir vaqt oralig'iga necha nafar nomzod qabul qilinishi mumkin (standart: 1).
SLOT_CAPACITY=1

# --- Ixtiyoriy: Firebase Firestore ---
# Firebase Console > Project Settings > Service Accounts > Generate new private key
# Fayl yo'lini shu yerga yozing. Bo'sh qoldirilsa, bot avtomatik lokal SQLite (data.db) ishlatadi.
FIREBASE_CREDENTIALS_PATH=
